{
  "name": "slipstream",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:circuit": "tsx scripts/circuit-drive.ts",
    "format": "prettier --write src server tests scripts docs README.md index.html package.json tsconfig.json vite.config.ts render.yaml",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.2.1",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
